# Bash syntax. For values containing quotes/special characters, use safe quoting.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=framework
TZME_DB_URL='jdbc:mysql://127.0.0.1:3306/tzme_corporate?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8'
TZME_DB_USER=tzme_app
TZME_DB_PASSWORD='REPLACE_WITH_CLOUD_DATABASE_PASSWORD'
TZME_FRONTEND_DIR=/var/www/tzme
TZME_UPLOAD_DIR=/var/lib/tzme/uploads
# Local SSH-tunnel HTTP testing: false. Change to true before public HTTPS use.
TZME_SESSION_COOKIE_SECURE=false
TZME_DDL_AUTO=validate
TZME_SQL_INIT_MODE=always
TZME_ADMIN_RESET_PASSWORD=false
TZME_RANK_AUTO_ENABLED=false
# Add TZME_SERPAPI_KEY here only if needed. No VITE_* secrets.
