# Vite development proxy. The Java server must listen at this address.
VITE_API_TARGET=http://127.0.0.1:8080

# Export the following variables in the Java process environment.
# Database CLI scripts use HOST/PORT/NAME; Java uses DB_URL.
TZME_DB_HOST=127.0.0.1
TZME_DB_PORT=3306
TZME_DB_NAME=tzme_corporate
TZME_DB_URL=jdbc:mysql://127.0.0.1:3306/tzme_corporate?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
TZME_DB_USER=tzme_app
TZME_DB_PASSWORD=replace_with_your_password
SERVER_PORT=8080
TZME_SQL_INIT_MODE=always
TZME_DDL_AUTO=validate
TZME_UPLOAD_DIR=./uploads
